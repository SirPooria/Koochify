# 1. Supabase Cloud Database (Required for Production & Vercel)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
# IMPORTANT: Use the "service_role" secret key (NOT anon key) to bypass RLS securely on server
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Google Gemini AI Engine
GEMINI_API_KEY="AIzaSy..."

# 3. Server & Deployment URLs
PORT=3000
APP_URL="https://your-domain.vercel.app"

# 6. Online Payment Gateway (ZarinPal / Zibal Merchant ID)
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Leave empty to enable instant sandbox test simulator
MERCHANT_ID=""

# 7. Admin Leads Panel Protection Password
# Used to access /admin/leads and manually verify payments or export leads
ADMIN_PASSWORD="koochify2026"

# 8. Melipayamak SMS Gateway (ارسال سریع بر اساس پترن خدماتی SendByBaseNumber2)
# پترن پیش‌فرض احراز هویت ورود: 567584
MELIPAYAMAK_USERNAME="989387596456"
MELIPAYAMAK_API_KEY="8fd880f4-1576-41c8-80c0-ca5fd00f194b"
MELIPAYAMAK_BODY_ID="567584"
