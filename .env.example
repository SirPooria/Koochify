# ==============================================================================
# Koochify (کوچیفای) - Environment Variables Configuration
# ==============================================================================

# 1. Supabase Cloud Database (Required for Production & Vercel)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
# IMPORTANT: Use the "service_role" secret key (NOT anon key) to bypass RLS securely on server
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Google Gemini AI Engine
GEMINI_API_KEY="AIzaSy..."

# 3. Server & Deployment URLs
PORT=3000
APP_URL="https://your-domain.vercel.app"

# 4. Fast Card-to-Card Payment Details (بدون نیاز به اینماد)
CARD_NUMBER="6037-9979-1234-5678"
CARD_HOLDER="به نام مدیریت سامانه کوچیفای"
BANK_NAME="بانک ملی ایران"

# 5. Instant Auto Unlock for Card-to-Card Submissions
# true: User gets immediately unlocked upon entering the 4 last digits/ref code for zero friction.
# false: Admin manually verifies in /admin/leads before unlocking.
AUTO_UNLOCK_CARD_TO_CARD="true"

# 6. Online Payment Gateway (ZarinPal / Zibal Merchant ID)
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Leave empty to enable instant sandbox test simulator
MERCHANT_ID=""

# 7. Admin Leads Panel Protection Password
# Used to access /admin/leads and manually verify payments or export leads
ADMIN_PASSWORD="koochify2026"

# 8. SMS Gateway API Key (Kavenegar / Ghasedak / FarazSMS)
# If empty or not set, development mode prints OTP codes to console & API responses.
SMS_API_KEY=""
